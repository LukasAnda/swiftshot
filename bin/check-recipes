#!/usr/bin/env python3
"""Checks the CI recipes in docs/wiki/CI-*.md.

A fenced block whose first line is `# swiftshot-recipe: <kind>` (or `// swiftshot-recipe: <kind>`
for a Jenkinsfile) is validated by kind:

  github-workflow <file>   actionlint; the block must equal <file> after the tag line
  gitlab-ci, bitbucket-pipelines, bitrise, codemagic, circleciconfig, azure-pipelines
                           check-jsonschema against Shared/ci-schemas/<kind>.json
  jenkins                  balanced braces only (no schema exists)

The github accept recipe is also run, with `gh` stubbed, on sample comments (needs bash and jq), and
this repository's own accept workflow must hold the recipe's `prepare` step byte for byte.

Every CI page must hold a block of its kind and name its accept job exactly as the hint in
Summary.kt does. Needs python3, check-jsonschema and actionlint on PATH.

  bin/check-recipes              check the repository, and run the accept recipe's comment parsing on sample comments
  bin/check-recipes --self-test  prove that broken blocks fail
"""
import contextlib
import io
import os
import re
import shutil
import subprocess
import sys
import tempfile

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

# page -> (kind, the name its accept job or stage must have)
PAGES = {
    "CI-GitHub-Actions.md": ("github-workflow", "/swiftshot accept"),
    "CI-GitLab.md": ("gitlab-ci", "swiftshot-accept"),
    "CI-Bitbucket.md": ("bitbucket-pipelines", "swiftshot-accept"),
    "CI-Bitrise.md": ("bitrise", "swiftshot-accept"),
    "CI-Codemagic.md": ("codemagic", "swiftshot-accept"),
    "CI-CircleCI.md": ("circleciconfig", "accept-screenshots"),
    "CI-Azure-Pipelines.md": ("azure-pipelines", "Accept screenshots"),
    "CI-Jenkins.md": ("jenkins", "Accept screenshots"),
}
SCHEMAS = {k for k, _ in PAGES.values()} - {"github-workflow", "jenkins"}
FENCE = re.compile(r"^```(\w*)[ \t]*\n(.*?)^```[ \t]*$", re.S | re.M)
TAG = re.compile(r"^(?:#|//) swiftshot-recipe: (\S+)(?: (\S+))?[ \t]*$")


def blocks(text):
    for m in FENCE.finditer(text):
        body = m.group(2)
        tag = TAG.match(body.split("\n", 1)[0])
        if tag:
            yield tag.group(1), tag.group(2), body


def run(cmd):
    env = dict(os.environ, PYTHONWARNINGS="ignore")
    p = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, universal_newlines=True, env=env)
    return p.returncode, p.stdout.strip()


def balanced(src):
    """Braces and parentheses of a Jenkinsfile, ignoring comments and string contents."""
    src = re.sub(r"'''.*?'''|\"\"\".*?\"\"\"", "''", src, flags=re.S)
    src = re.sub(r"//[^\n]*|/\*.*?\*/", "", src, flags=re.S)
    src = re.sub(r"'(?:\\.|[^'\\\n])*'|\"(?:\\.|[^\"\\\n])*\"", "''", src)
    stack = []
    for ch in src:
        if ch in "{(":
            stack.append(ch)
        elif ch in "})":
            if not stack or stack.pop() != {"}": "{", ")": "("}[ch]:
                return False
    return not stack


def check_block(kind, ref, body, root, tmp):
    """Returns a list of problems."""
    if kind == "jenkins":
        return [] if balanced(body) else ["unbalanced braces or parentheses"]
    path = os.path.join(tmp, "block.yml")
    with open(path, "w") as f:
        f.write(body)
    if kind == "github-workflow":
        problems = []
        if not ref:
            return ["github-workflow needs the recipe file after the tag"]
        try:
            with open(os.path.join(root, ref)) as f:
                same = f.read().strip() == body.split("\n", 1)[1].strip()
        except OSError as e:
            return [str(e)]
        if not same:
            problems.append("differs from %s; paste the file after the tag line" % ref)
        code, out = run(["actionlint", "-no-color", path])
        if code:
            problems.append(out)
        return problems
    if kind not in SCHEMAS:
        return ["unknown recipe kind %r" % kind]
    code, out = run(["check-jsonschema", "--regex-variant", "nonunicode", "--schemafile", os.path.join(root, "Shared", "ci-schemas", kind + ".json"), path])
    return [out] if code else []


def check(root, wiki):
    failed = 0
    for page, (kind, accept) in sorted(PAGES.items()):
        path = os.path.join(wiki, page)
        if not os.path.isfile(path):
            print("FAIL %s: missing" % page)
            failed += 1
            continue
        with open(path) as f:
            text = f.read()
        found = 0
        for n, (k, ref, body) in enumerate(blocks(text), 1):
            found += k == kind
            with tempfile.TemporaryDirectory() as tmp:
                problems = check_block(k, ref, body, root, tmp)
            if k != kind:
                problems.append("a %s block on a %s page" % (k, kind))
            for p in problems:
                print("FAIL %s block %d (%s): %s" % (page, n, k, p))
            failed += bool(problems)
            if not problems:
                print("ok   %s block %d (%s)" % (page, n, k))
        if not found:
            print("FAIL %s: no `swiftshot-recipe: %s` block" % (page, kind))
            failed += 1
        if accept not in text:
            print("FAIL %s: does not name %r" % (page, accept))
            failed += 1
    return failed


def self_test():
    """Copies the pages, breaks one block of each kind, and expects exactly that page to fail, for the right reason."""
    schema = r"Schema validation errors were encountered"
    breaks = {  # kind: (text to replace, replacement, pattern the failure message must match)
        "gitlab-ci": ("when: always", "when: sometimes", schema),
        "bitbucket-pipelines": ("image: atlassian/default-image:4", "image: [5]", schema),
        "bitrise": ("format_version: \"11\"", "format_version: [11]", schema),
        "codemagic": ("instance_type: mac_mini_m2", "instance_type: [5]", schema),
        "circleciconfig": ("version: 2.1", "version: [2]", schema),
        "azure-pipelines": ("trigger: none", "trigger: [[5]]", schema),
        "jenkins": ("stage('Verify') {", "stage('Verify') {{", "unbalanced"),
        # actionlint prints file:line:col: message [rule]
        "github-workflow": ("runs-on:", "runz-on:", r"block\.yml:\d+:\d+"),
    }
    ok = True
    wiki = os.path.join(ROOT, "docs", "wiki")
    for page, (kind, _) in sorted(PAGES.items()):
        with open(os.path.join(wiki, page)) as f:
            text = f.read()
        old, new, reason = breaks[kind]
        if old not in text:
            print("self-test: cannot break %s, %r not found" % (page, old))
            ok = False
            continue
        with tempfile.TemporaryDirectory() as tmp:
            for p in PAGES:
                shutil.copy(os.path.join(wiki, p), os.path.join(tmp, p))
            with open(os.path.join(tmp, page), "w") as f:
                f.write(text.replace(old, new, 1))
            buf = io.StringIO()
            with contextlib.redirect_stdout(buf):
                check(ROOT, tmp)
        out = buf.getvalue()
        failing = {l.split()[1].rstrip(":") for l in out.splitlines() if l.startswith("FAIL")}
        good = failing == {page} and re.search(reason, out) is not None
        print("self-test %-24s %s" % (page, "fails as expected" if good else "WRONG: failing pages %s, reason %r not found" % (sorted(failing), reason) if failing == {page} else "WRONG: failing pages %s" % sorted(failing)))
        ok = ok and good
    # The comment parsing: without the out-of-date refusal, the hex check or the minimum length, the sample comments fail.
    with open(os.path.join(ROOT, ACCEPT_RECIPE)) as f:
        recipe = f.read()
    mutants = {
        "no out-of-date refusal": ('[ -z "$token" ] || [[ "$sha" == "$token"* ]] || refuse', 'true || refuse'),
        "no hex check": ("*[!0-9a-fA-F]*) refuse", "*[!0-9a-fA-F]*) true"),
        "no minimum length": ('[ "${#token}" -ge 7 ] && ', ''),
    }
    for name, (old, new) in mutants.items():
        if old not in recipe:
            print("self-test: cannot break the accept recipe (%s), %r not found" % (name, old))
            ok = False
            continue
        with tempfile.TemporaryDirectory() as tmp:
            os.makedirs(os.path.join(tmp, os.path.dirname(ACCEPT_RECIPE)))
            with open(os.path.join(tmp, ACCEPT_RECIPE), "w") as f:
                f.write(recipe.replace(old, new, 1))
            problems = accept_behaviour(tmp)
        good = bool(problems)
        print("self-test accept recipe, %-22s %s" % (name, "fails as expected" if good else "WRONG: no sample comment failed"))
        ok = ok and good
    # The in-repo accept workflow's prepare step: any change to it, or to the recipe's, must fail.
    for name, target, old, new in (("workflow", ACCEPT_WORKFLOW, "head -n 1", "head -n 2"), ("recipe", ACCEPT_RECIPE, "tr -d '\\r'", "tr -d '\\n'")):
        with tempfile.TemporaryDirectory() as tmp:
            for f in (ACCEPT_RECIPE, ACCEPT_WORKFLOW):
                os.makedirs(os.path.join(tmp, os.path.dirname(f)), exist_ok=True)
                shutil.copy(os.path.join(ROOT, f), os.path.join(tmp, f))
            path = os.path.join(tmp, target)
            with open(path) as f:
                text = f.read()
            if old not in text:
                print("self-test: cannot break the %s's prepare step, %r not found" % (name, old))
                ok = False
                continue
            with open(path, "w") as f:
                f.write(text.replace(old, new, 1))
            good = bool(prepare_drift(tmp))
        print("self-test prepare step, %-18s %s" % ("changed " + name, "fails as expected" if good else "WRONG: no drift found"))
        ok = ok and good
    return ok


ACCEPT_RECIPE = "docs/recipes/github/screenshots-accept.yml"
ACCEPT_WORKFLOW = ".github/workflows/screenshots-accept.yml"
HEAD = "a1b2c3d4e5f60718293a4b5c6d7e8f9012345678"
STUB_GH = r"""#!/bin/bash
# A gh that answers the calls of the accept recipe's first step.
case "$*" in
  *collaborators*) echo "${STUB_PERMISSION:-write}" ;;
  *"/pulls/"*) printf '{"head":{"sha":"%s","ref":"feature/x","repo":{"full_name":"acme/app"}}}' "$STUB_HEAD" ;;
  *workflows/screenshots.yml/runs*) echo 4242 ;;
  *artifacts*) echo "https://example.com/report.zip" ;;
  *issues/*/comments*) for a in "$@"; do case "$a" in body=*) printf '%s\n' "${a#body=}" >> "$STUB_REPLIES" ;; esac; done ;;
esac
"""


def prepare_script(recipe):
    """The run: script of the step `prepare`, as the shell gets it."""
    lines = recipe.split("\n")
    start = next(i for i, l in enumerate(lines) if l.strip() == "id: prepare")
    run = next(i for i in range(start, len(lines)) if lines[i] == "        run: |")
    body = []
    for l in lines[run + 1:]:
        if l.strip() and not l.startswith(" " * 10):
            break
        body.append(l[10:])
    return "\n".join(body) + "\n"


def prepare_step(text):
    """The whole step `prepare` (from its `- name:` line to the next step), as written."""
    lines = text.split("\n")
    at = next(i for i, l in enumerate(lines) if l.strip() == "id: prepare")
    start = next(i for i in range(at, -1, -1) if lines[i].startswith("      - "))
    end = next((i for i in range(at + 1, len(lines)) if lines[i].startswith("      - ")), len(lines))
    return "\n".join(lines[start:end]).rstrip("\n")


def prepare_drift(root):
    """Problems if the repository's accept workflow's `prepare` step differs from the recipe's."""
    try:
        with open(os.path.join(root, ACCEPT_RECIPE)) as f:
            recipe = prepare_step(f.read())
        with open(os.path.join(root, ACCEPT_WORKFLOW)) as f:
            workflow = prepare_step(f.read())
    except (OSError, StopIteration) as e:
        return ["cannot compare the prepare steps: %r" % (e,)]
    if recipe != workflow:
        return ["the `prepare` step of %s differs from %s; it must be the same, byte for byte" % (ACCEPT_WORKFLOW, ACCEPT_RECIPE)]
    return []


def run_prepare(script, comment, head=HEAD, permission="write"):
    """(outputs, replies, files created) of the step for a comment."""
    with tempfile.TemporaryDirectory() as tmp:
        bindir = os.path.join(tmp, "bin")
        os.mkdir(bindir)
        with open(os.path.join(bindir, "gh"), "w") as f:
            f.write(STUB_GH)
        os.chmod(os.path.join(bindir, "gh"), 0o755)
        work = os.path.join(tmp, "work")
        os.mkdir(work)
        out, replies = os.path.join(tmp, "output"), os.path.join(tmp, "replies")
        open(out, "w").close()
        env = dict(os.environ, PATH=bindir + os.pathsep + os.environ["PATH"], GITHUB_OUTPUT=out, STUB_REPLIES=replies, STUB_HEAD=head,
                   STUB_PERMISSION=permission, REPO="acme/app", PR="7", ACTOR="dev", COMMENT=comment, GH_TOKEN="x")
        p = subprocess.run(["bash", "-e", "-c", script], cwd=work, env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, universal_newlines=True)
        values = dict(l.split("=", 1) for l in open(out).read().splitlines() if "=" in l)
        got = open(replies).read() if os.path.exists(replies) else ""
        return p.returncode, p.stdout, values, got, os.listdir(work)


def accept_behaviour(root):
    """Runs the accept recipe's first step on comments; returns a list of problems."""
    with open(os.path.join(root, ACCEPT_RECIPE)) as f:
        recipe = f.read()
    problems = []
    if "startsWith(github.event.comment.body, '/swiftshot accept')" not in recipe:
        problems.append("the trigger no longer matches a comment that starts with /swiftshot accept")
    script = prepare_script(recipe)
    sub, rest = HEAD[:7], "\n"
    ids = "en-US/Pixel 9-Home\n  deadbeef \r\nen-US/Pixel 9-Settings"
    # (comment, proceeds, the --only ids, text the reply must contain, or None for no reply)
    cases = [
        ("/swiftshot accept", True, [], None),
        ("/swiftshot accept " + HEAD, True, [], None),
        ("/swiftshot accept " + HEAD + "\r\n" + ids, True, ["en-US/Pixel 9-Home", "deadbeef", "en-US/Pixel 9-Settings"], None),
        ("/swiftshot accept " + sub, True, [], None),
        ("/swiftshot accept " + sub.upper() + "  ", True, [], None),
        ("/swiftshot accept\n" + ids, True, ["en-US/Pixel 9-Home", "deadbeef", "en-US/Pixel 9-Settings"], None),
        ("/swiftshot accept a1b2c3e", False, None, "out of date"),
        ("/swiftshot accept " + "0" * 40 + "\nen-US/Pixel 9-Home", False, None, "out of date"),
        ("/swiftshot accept a1b2c3", False, None, "7 to 64"),
        ("/swiftshot accept " + "a" * 65, False, None, "7 to 64"),
        ("/swiftshot accept en-US/Pixel 9-Home", False, None, "first line"),
        ("/swiftshot accept " + sub + " extra", False, None, "first line"),
        ("/swiftshot accept $(touch pwned)", False, None, "first line"),
        ("/swiftshot accept " + sub + "; touch pwned", False, None, "first line"),
        ("/swiftshot accept `touch pwned`", False, None, "first line"),
        ("/swiftshot acceptance", False, None, None),
        ("hello\n/swiftshot accept", False, None, None),
    ]
    for comment, proceeds, only, reply in cases:
        code, out, values, replies, files = run_prepare(script, comment)
        what = repr(comment)
        if code:
            problems.append("%s: the step failed: %s" % (what, out))
        elif (values.get("proceed") == "true") != proceeds:
            problems.append("%s: proceed=%s" % (what, values.get("proceed")))
        elif files:
            problems.append("%s: ran something, left %s" % (what, files))
        elif reply is None and replies:
            problems.append("%s: replied %r" % (what, replies))
        elif reply is not None and reply not in replies:
            problems.append("%s: reply %r lacks %r" % (what, replies, reply))
        elif proceeds:
            import shlex
            args = shlex.split(values.get("args", ""))
            if args != ["--push", "--branch", "feature/x"] + [x for i in only for x in ("--only", i)]:
                problems.append("%s: args %s" % (what, args))
        elif reply is not None and "pwned" in replies:
            problems.append("%s: the reply repeats the comment: %r" % (what, replies))
    code, out, values, replies, files = run_prepare(script, "/swiftshot accept deadbeef", permission="read")
    if values.get("proceed") == "true" or "write access" not in replies:
        problems.append("a reader's out-of-date comment is answered with %r" % replies)
    return problems


def main():
    for tool in ("check-jsonschema", "actionlint"):
        if not shutil.which(tool):
            sys.exit("%s is not on PATH" % tool)
    if sys.argv[1:] == ["--self-test"]:
        sys.exit(0 if self_test() else 1)
    if sys.argv[1:]:
        sys.exit(__doc__)
    failed = check(ROOT, os.path.join(ROOT, "docs", "wiki"))
    problems = accept_behaviour(ROOT)
    drift = prepare_drift(ROOT)
    if not drift:
        print("ok   accept workflow's prepare step equals the recipe's")
    problems += drift
    for p in problems:
        print("FAIL accept recipe: %s" % p)
    if not problems:
        print("ok   accept recipe comment parsing")
    sys.exit(1 if failed or problems else 0)


if __name__ == "__main__":
    main()
