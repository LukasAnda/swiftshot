    "Check in once a day, keep your streaks honest and see your week take shape.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل مرة واحدة في اليوم، وحافظ على سلاسلك بصدق، وشاهد أسبوعك يتشكّل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal am Tag abhaken, Serien ehrlich halten und zusehen, wie deine Woche Gestalt annimmt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1日1回チェックするだけ。連続記録を積み重ね、1週間の形が見えてきます。"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Raz denne si odškrtnite, držte svoje série poctivo a sledujte, ako sa váš týždeň formuje."
          }
        }
      }
    },
